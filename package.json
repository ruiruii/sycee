{
  "name": "sycee",
  "version": "0.1.0",
  "private": true,
  "description": "Agent spend semantics: consumption and redemption counting for machine payments.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/*/test/*.test.mjs",
    "vectors": "node packages/conformance/src/cli.mjs gen-vectors",
    "verify": "node packages/conformance/src/cli.mjs verify --manifest conformance/vectors/valid-*.json conformance/vectors/invalid-*.json",
    "verify:l0": "node packages/conformance/src/cli.mjs verify --level=L0",
    "verify:l1": "node packages/conformance/src/cli.mjs verify --level=L1",
    "verify:l2": "node packages/conformance/src/cli.mjs verify --level=L2",
    "demo": "node examples/walkthrough.mjs"
  }
}
