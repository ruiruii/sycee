{
  "name": "sycee",
  "version": "0.1.0",
  "private": true,
  "description": "Agent spend semantics: consumption and redemption counting for machine payments.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/demo-merchant"
  ],
  "scripts": {
    "test": "node --test packages/*/test/*.test.mjs conformance/*/test/*.test.mjs examples/demo-merchant/test/*.test.mjs",
    "vectors": "node packages/conformance/src/cli.mjs gen-vectors",
    "verify": "node packages/conformance/src/cli.mjs verify --manifest conformance/vectors/valid-*.json conformance/vectors/invalid-*.json",
    "verify:l0": "node packages/conformance/src/cli.mjs verify --level=L0",
    "verify:l1": "node packages/conformance/src/cli.mjs verify --level=L1",
    "verify:l2": "node packages/conformance/src/cli.mjs verify --level=L2",
    "demo": "node examples/walkthrough.mjs",
    "demo:refusal": "node examples/refusal-walkthrough.mjs",
    "demo:merchant": "node examples/demo-merchant/src/dev-server.mjs",
    "matrix": "node conformance/vectors/print-matrix.mjs",
    "verify:refusal": "node conformance/refusal/judge.mjs --expect=76",
    "demo:bilateral": "node examples/bilateral-consumption.mjs",
    "verify:py": "PYTHONPATH=python python3 -m sycee_verify conformance/vectors/*.json",
    "verify:docs": "node conformance/refusal/docs-parity.mjs",
    "try": "node bin/sycee-verify.mjs --example",
    "verify:receipt": "node bin/sycee-verify.mjs",
    "test:examples": "node examples/walkthrough.mjs && node examples/bilateral-consumption.mjs && node examples/buyer-reconcile.mjs && node examples/refusal-walkthrough.mjs"
  },
  "bin": {
    "sycee-verify": "./bin/sycee-verify.mjs",
    "sycee-doctor": "./bin/sycee-doctor.mjs"
  }
}
